    // ==========================================
    // 9. MODALS & TOAST HELPERS
    // ==========================================
    function openModal(id) {
      if (id === 'dashboard-modal') renderDashboard();
      if (id === 'social-modal') renderSocialAccounts();
      const el = document.getElementById(id);
      el.classList.remove('hidden');
      el.classList.add('flex');
    }

    function closeModal(id) {
      const el = document.getElementById(id);
      el.classList.add('hidden');
      el.classList.remove('flex');
    }

    function showToast(msg) {
      const container = document.getElementById('toast-container');
      const toast = document.createElement('div');
      toast.className = 'glass px-4 py-2.5 rounded-2xl text-xs font-semibold text-white border border-indigo-400/40 shadow-xl transition-opacity duration-300';
      toast.textContent = msg;
      container.appendChild(toast);
      setTimeout(() => {
        toast.style.opacity = '0';
        setTimeout(() => toast.remove(), 300);
      }, 3200);
    }

    // ==========================================
    // 10. 3D ANIMATION LOOP & HTML LABEL PROJECTION
    // ==========================================
    const clock = new THREE.Clock();
    const tempVec = new THREE.Vector3();

    function animate() {
      requestAnimationFrame(animate);
      const elapsed = clock.getElapsedTime();

      EMPLOYEES.forEach((emp, i) => {
        const m = employeeMeshes[emp.id];
        const dist = m.group.position.distanceTo(m.targetPos);

        // Smooth walking movement toward target zone
        if (dist > 0.08) {
          m.group.position.lerp(m.targetPos, 0.045);
          const angle = Math.atan2(m.targetPos.x - m.group.position.x, m.targetPos.z - m.group.position.z);
          m.group.rotation.y = angle;
          // Walking bob & arm swing
          m.group.position.y = Math.abs(Math.sin(elapsed * 10 + i)) * 0.12;
          m.leftArm.rotation.x = Math.sin(elapsed * 10 + i) * 0.6;
          m.rightArm.rotation.x = -Math.sin(elapsed * 10 + i) * 0.6;
          m.torso.rotation.x = 0;
        } else {
          m.group.position.y = 0;
          m.group.rotation.y += (m.targetRotY - m.group.rotation.y) * 0.1;

          // Activity-specific 3D animations
          if (emp.activity === 'work') {
            // Fast typing / editing arm motion
            m.leftArm.rotation.x = -0.9 + Math.sin(elapsed * 18 + i) * 0.18;
            m.rightArm.rotation.x = -0.9 + Math.cos(elapsed * 18 + i) * 0.18;
            m.head.rotation.y = Math.sin(elapsed * 2 + i) * 0.15;
            m.torso.rotation.x = 0;
          } else if (emp.activity === 'meeting') {
            // Explaining / gesturing in meeting
            m.rightArm.rotation.x = -0.7 + Math.sin(elapsed * 5 + i) * 0.4;
            m.leftArm.rotation.x = -0.2;
            m.head.rotation.y = Math.sin(elapsed * 1.8 + i) * 0.25;
            m.torso.rotation.x = 0;
          } else if (emp.activity === 'coffee') {
            // Sipping coffee motion
            m.rightArm.rotation.x = -1.2 + Math.sin(elapsed * 2.5 + i) * 0.35;
            m.leftArm.rotation.x = 0;
            m.torso.rotation.x = 0;
          } else if (emp.activity === 'sleep' && m.lying) {
            // Lying comfortably on bed
            m.group.position.y = 0.85;
            m.torso.rotation.x = -Math.PI / 2;
            m.head.position.set(0, 1.0, -0.65);
            m.leftArm.rotation.x = 0;
            m.rightArm.rotation.x = 0;
          } else {
            // Relaxed breathing / walking in garden
            m.leftArm.rotation.x = Math.sin(elapsed * 2 + i) * 0.1;
            m.rightArm.rotation.x = -Math.sin(elapsed * 2 + i) * 0.1;
            m.torso.rotation.x = 0;
          }
        }

        // Reset head pos when not lying down
        if (!(emp.activity === 'sleep' && m.lying && dist <= 0.08)) {
          m.head.position.set(0, 1.68, 0);
        }

        // Highlight ring pulse if selected
        if (emp.id === selectedEmployeeId) {
          m.ring.scale.setScalar(1.15 + Math.sin(elapsed * 5) * 0.12);
        } else {
          m.ring.scale.setScalar(1.0);
        }

        // Project 3D position above head to 2D screen coordinates for floating bubble & nameplate
        tempVec.set(m.group.position.x, m.group.position.y + 2.35, m.group.position.z);
        tempVec.project(camera);

        if (tempVec.z < 1) {
          const x = (tempVec.x * 0.5 + 0.5) * window.innerWidth;
          const y = (-tempVec.y * 0.5 + 0.5) * window.innerHeight;
          m.tagEl.style.left = `${x}px`;
          m.tagEl.style.top = `${y}px`;
          m.tagEl.style.opacity = '1';
        } else {
          m.tagEl.style.opacity = '0';
        }
      });

      renderer.render(scene, camera);
    }

    window.addEventListener('resize', () => {
      camera.aspect = window.innerWidth / window.innerHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(window.innerWidth, window.innerHeight);
    });

    window.onload = function () {
      renderEmployeeDock();
      updateHudBadges();
      selectEmployee('ilham', false);
      animate();
    };
  </script>
