    function toggleSocialLogin(id) {
      const acc = SOCIAL_ACCOUNTS.find(a => a.id === id);
      if (!acc) return;
      const inputEl = document.getElementById(`handle-${id}`);
      if (inputEl && inputEl.value.trim()) acc.handle = inputEl.value.trim();

      acc.connected = !acc.connected;
      if (acc.connected && acc.uploadedToday === 0) {
        acc.uploadedToday = 1;
        addLog('Abbas', `Login berhasil ke ${acc.name} (${acc.handle}) & menjadwalkan 5 Reel/hari.`);
        showToast(`✅ Berhasil terhubung ke ${acc.name}!`);
