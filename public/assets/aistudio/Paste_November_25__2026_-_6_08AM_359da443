    function updateHudBadges() {
      const connected = SOCIAL_ACCOUNTS.filter(a => a.connected);
      const totalUploaded = connected.reduce((sum, a) => sum + a.uploadedToday, 0);
      const totalTarget = connected.reduce((sum, a) => sum + a.dailyTarget, 0);

      document.getElementById('hud-social-count').textContent = `${connected.length} Aktif`;
      document.getElementById('hud-upload-badge').textContent = `${totalUploaded}/${totalTarget || 5} Reel`;
