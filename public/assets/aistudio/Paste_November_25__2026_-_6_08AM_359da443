    // ==========================================
    // 8. REAL-TIME CLOCK & AUTONOMOUS AI LOOP
    // ==========================================
    function updateRealTimeClock() {
      const now = new Date();
      const timeFormatted = now.toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
      const dateFormatted = now.toLocaleDateString('id-ID', { weekday: 'long', day: 'numeric', month: 'short', year: 'numeric' });
      document.getElementById('realtime-clock').textContent = `${timeFormatted} WIB`;
      document.getElementById('realtime-date').textContent = dateFormatted;
    }
    setInterval(updateRealTimeClock, 1000);
    updateRealTimeClock();

    function toggleAutoMode() {
      autoMode = !autoMode;
      const btn = document.getElementById('auto-mode-btn');
      const dot = document.getElementById('auto-mode-dot');
      if (autoMode) {
        btn.classList.replace('bg-slate-600', 'bg-emerald-500');
        dot.classList.add('translate-x-5');
        showToast('🤖 Mode Otomatis AI Aktif');
