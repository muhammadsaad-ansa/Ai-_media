        <div class="px-2.5 py-0.5 rounded-full text-[11px] font-bold text-white shadow-md flex items-center gap-1 border border-white/20" style="background:${emp.color}">
          <span>${emp.emoji}</span>
          <span>${emp.name}</span>
          <span class="opacity-80 font-normal text-[9px]">(${emp.shortRole})</span>
        </div>
      `;
      labelsLayer.appendChild(tagEl);

      employeeMeshes[emp.id] = {
        group,
        torso,
        head,
        leftArm,
        rightArm,
        ring,
        tagEl,
        targetPos: new THREE.Vector3(startPos.x, 0, startPos.z),
        targetRotY: startPos.rotY,
        lying: false
      };
    });

    // Apply initial employee activities
    EMPLOYEES.forEach(emp => updateEmployeeTarget(emp));

    function updateEmployeeTarget(emp) {
      const idx = emp.deskIndex;
      const meshData = employeeMeshes[emp.id];
      let spot = deskChairTargets[idx];
      meshData.lying = false;

      if (emp.activity === 'work') {
        spot = deskChairTargets[idx];
      } else if (emp.activity === 'meeting') {
        spot = meetingSpots[idx];
      } else if (emp.activity === 'coffee') {
        spot = coffeeSpots[idx];
      } else if (emp.activity === 'sleep') {
        spot = sleepSpots[idx];
        meshData.lying = !!spot.lying;
      } else if (emp.activity === 'garden') {
        spot = gardenSpots[idx];
      }

      meshData.targetPos.set(spot.x, 0, spot.z);
      meshData.targetRotY = spot.rotY;

      // Update default speech bubble if customBubble is empty
      if (!emp.customBubble) {
        const defaultTexts = {
          work: getDefaultWorkText(emp.id),
          meeting: `📋 Diskusi strategi konten bareng tim`,
          coffee: `☕ Ngopi santai biar ide ngalir!`,
          sleep: `💤 Istirahat sejenak recharge CPU...`,
          garden: `🌳 Cari inspirasi segar di taman`
        };
        emp.statusText = defaultTexts[emp.activity];
      } else {
        emp.statusText = emp.customBubble;
      }

      const bubbleEl = document.getElementById(`bubble-${emp.id}`);
      if (bubbleEl) bubbleEl.textContent = emp.statusText;
    }

    function getDefaultWorkText(id) {
      switch (id) {
        case 'ilham': return '🎬 Lagi ngedit transisi Reel viral...';
        case 'saad': return '👔 Cek KPI & koordinasi 7 AI...';
        case 'ilyas': return '✨ Bikin animasi 30 detik (60fps)...';
        case 'hamza': return '📊 Riset tren & audio FYP hari ini...';
        case 'abdaziz': return '✍️ Nulis materi & hook konten baru...';
        case 'abbas': return '🚀 Auto-upload 5 Reel/hari ke sosmed!';
        case 'zubair': return '💬 Balas chat & DM customer ramah...';
        default: return '💻 Sedang bekerja...';
      }
    }

    // ==========================================
    // 5. CAMERA ORBIT, ZOOM & RAYCASTING CONTROLS
    // ==========================================
    let camTarget = new THREE.Vector3(-1, 0, 0);
    let camSpherical = { radius: 34, theta: 0.25, phi: 0.92 };
    let isDragging = false;
    let prevMouse = { x: 0, y: 0 };
    let dragDistance = 0;

    function updateCameraPosition() {
      const x = camTarget.x + camSpherical.radius * Math.sin(camSpherical.phi) * Math.sin(camSpherical.theta);
      const y = camTarget.y + camSpherical.radius * Math.cos(camSpherical.phi);
      const z = camTarget.z + camSpherical.radius * Math.sin(camSpherical.phi) * Math.cos(camSpherical.theta);
      camera.position.set(x, Math.max(3, y), z);
      camera.lookAt(camTarget);
    }
    updateCameraPosition();

    // Pointer Events (Mouse + Touch)
    renderer.domElement.addEventListener('pointerdown', (e) => {
      isDragging = true;
      dragDistance = 0;
      prevMouse = { x: e.clientX, y: e.clientY };
    });

    window.addEventListener('pointermove', (e) => {
      if (!isDragging) return;
      const dx = e.clientX - prevMouse.x;
      const dy = e.clientY - prevMouse.y;
      dragDistance += Math.abs(dx) + Math.abs(dy);
      camSpherical.theta -= dx * 0.007;
      camSpherical.phi = Math.max(0.32, Math.min(1.38, camSpherical.phi - dy * 0.007));
      prevMouse = { x: e.clientX, y: e.clientY };
      updateCameraPosition();
    });

    window.addEventListener('pointerup', (e) => {
      if (isDragging && dragDistance < 6) {
        handleCanvasClick(e);
      }
      isDragging = false;
    });

    renderer.domElement.addEventListener('wheel', (e) => {
      e.preventDefault();
      camSpherical.radius = Math.max(10, Math.min(52, camSpherical.radius + e.deltaY * 0.02));
      updateCameraPosition();
    }, { passive: false });

    const raycaster = new THREE.Raycaster();
    const mouseVec = new THREE.Vector2();

    function handleCanvasClick(e) {
      const rect = renderer.domElement.getBoundingClientRect();
      mouseVec.x = ((e.clientX - rect.left) / rect.width) * 2 - 1;
      mouseVec.y = -((e.clientY - rect.top) / rect.height) * 2 + 1;
      raycaster.setFromCamera(mouseVec, camera);
      const hits = raycaster.intersectObjects(clickableMeshes);
      if (hits.length > 0) {
        const empId = hits[0].object.userData.employeeId;
        selectEmployee(empId, true);
      }
    }

    function focusCameraZone(zone) {
      const zones = {
        overview: { target: [-1, 0, 0], radius: 34, theta: 0.25, phi: 0.92 },
        workstations: { target: [-8, 0, 0], radius: 17, theta: 0.1, phi: 0.88 },
        meeting: { target: [-10.5, 0, -9.5], radius: 14, theta: 0.0, phi: 0.85 },
        coffee: { target: [3.5, 0, -9.2], radius: 14, theta: -0.2, phi: 0.85 },
        bedroom: { target: [-12.5, 0, 10], radius: 15, theta: 0.3, phi: 0.85 },
        garden: { target: [16, 0, 0], radius: 18, theta: -0.5, phi: 0.88 }
      };
      const z = zones[zone] || zones.overview;
      camTarget.set(...z.target);
      camSpherical.radius = z.radius;
      camSpherical.theta = z.theta;
      camSpherical.phi = z.phi;
      updateCameraPosition();
    }

    // ==========================================
    // 6. UI RENDERING & INTERACTIONS
    // ==========================================
    function renderEmployeeDock() {
      const dock = document.getElementById('employee-dock');
      dock.innerHTML = EMPLOYEES.map(emp => {
        const isSelected = emp.id === selectedEmployeeId;
        return `
          <button onclick="selectEmployee('${emp.id}', true)"
            class="flex items-center gap-2 px-3 py-2 rounded-xl transition shrink-0 border ${isSelected ? 'bg-indigo-600/40 border-indigo-400 shadow-lg' : 'bg-slate-800/70 border-slate-700/70 hover:bg-slate-700/70'}">
            <span class="w-7 h-7 rounded-lg flex items-center justify-center text-sm shadow" style="background:${emp.color}">${emp.emoji}</span>
            <div class="text-left">
              <div class="text-xs font-bold text-white leading-none">${emp.name}</div>
              <div class="text-[10px] text-slate-300 mt-0.5">${emp.shortRole}</div>
            </div>
          </button>
        `;
      }).join('');
    }

    function selectEmployee(empId, openDrawer = true) {
      selectedEmployeeId = empId;
      const emp = EMPLOYEES.find(e => e.id === empId);
      if (!emp) return;

      renderEmployeeDock();

      // Focus camera gently on employee
      const meshPos = employeeMeshes[empId].group.position;
      camTarget.set(meshPos.x, 1, meshPos.z);
      camSpherical.radius = 15;
      updateCameraPosition();

      // Populate Right Drawer
      document.getElementById('drawer-avatar').style.background = emp.color;
      document.getElementById('drawer-avatar').textContent = emp.emoji;
      document.getElementById('drawer-name').textContent = emp.name;
      document.getElementById('drawer-badge').textContent = emp.role;
      document.getElementById('drawer-status-text').textContent = emp.statusText;
      document.getElementById('custom-bubble-input').value = emp.customBubble || '';
      document.getElementById('brain-tone').value = emp.tone;
      document.getElementById('brain-prompt').value = emp.prompt;
      document.getElementById('brain-temp').value = emp.temp;
      document.getElementById('brain-temp-val').textContent = emp.temp;

      // Highlight active activity button
      document.querySelectorAll('.act-btn').forEach(btn => {
        if (btn.dataset.act === emp.activity) {
          btn.classList.add('bg-indigo-600', 'border-indigo-400', 'text-white');
          btn.classList.remove('bg-slate-800', 'border-slate-700');
        } else {
          btn.classList.remove('bg-indigo-600', 'border-indigo-400', 'text-white');
          btn.classList.add('bg-slate-800', 'border-slate-700');
        }
      });

      renderEmployeePdfs(emp);

      if (openDrawer) {
        document.getElementById('employee-drawer').classList.remove('translate-x-[120%]');
      }
    }

    function closeEmployeeDrawer() {
      document.getElementById('employee-drawer').classList.add('translate-x-[120%]');
    }

    function setEmployeeActivity(activity) {
      const emp = EMPLOYEES.find(e => e.id === selectedEmployeeId);
      if (!emp) return;
      emp.activity = activity;
      emp.customBubble = '';
      updateEmployeeTarget(emp);
      selectEmployee(emp.id, false);
      addLog(emp.name, `Pindah aktivitas ke mode: ${activity.toUpperCase()}.`);
      showToast(`${emp.emoji} ${emp.name} sekarang: ${emp.statusText}`);
    }

    function applyCustomBubble() {
      const emp = EMPLOYEES.find(e => e.id === selectedEmployeeId);
      if (!emp) return;
      const val = document.getElementById('custom-bubble-input').value.trim();
      emp.customBubble = val;
      updateEmployeeTarget(emp);
      document.getElementById('drawer-status-text').textContent = emp.statusText;
      showToast(`💬 Status ${emp.name} diperbarui!`);
    }

    function saveEmployeeBrain() {
      const emp = EMPLOYEES.find(e => e.id === selectedEmployeeId);
      if (!emp) return;
      emp.tone = document.getElementById('brain-tone').value;
      emp.prompt = document.getElementById('brain-prompt').value;
      emp.temp = parseFloat(document.getElementById('brain-temp').value);
      addLog(emp.name, `Otak AI diperbarui (${emp.tone}).`);
      showToast(`🧠 Otak AI ${emp.name} berhasil disimpan!`);
    }

    function handlePdfUpload(event) {
      const file = event.target.files[0];
      if (!file) return;
      const emp = EMPLOYEES.find(e => e.id === selectedEmployeeId);
      if (!emp) return;

      const sizeKB = Math.max(12, Math.round(file.size / 1024));
      const sizeLabel = sizeKB > 1024 ? `${(sizeKB / 1024).toFixed(1)} MB` : `${sizeKB} KB`;

      emp.pdfs.push({
        name: file.name,
        size: sizeLabel,
        summary: `Modul pengetahuan PDF dipelajari oleh ${emp.name} (${emp.shortRole}).`
      });

      event.target.value = '';
      renderEmployeePdfs(emp);
      addLog(emp.name, `Mempelajari skill PDF baru: "${file.name}".`);
      showToast(`📄 Skill PDF "${file.name}" ditambahkan ke ${emp.name}!`);
    }

    function removePdfSkill(index) {
      const emp = EMPLOYEES.find(e => e.id === selectedEmployeeId);
      if (!emp) return;
      const removed = emp.pdfs.splice(index, 1);
      renderEmployeePdfs(emp);
      if (removed[0]) showToast(`🗑️ Skill "${removed[0].name}" dihapus.`);
    }

    function renderEmployeePdfs(emp) {
      document.getElementById('pdf-count-badge').textContent = `${emp.pdfs.length} PDF`;
      const list = document.getElementById('pdf-skill-list');
      if (emp.pdfs.length === 0) {
        list.innerHTML = `<div class="text-[11px] text-slate-500 italic text-center py-2">Belum ada file PDF skill ditambahkan.</div>`;
        return;
      }
      list.innerHTML = emp.pdfs.map((pdf, i) => `
