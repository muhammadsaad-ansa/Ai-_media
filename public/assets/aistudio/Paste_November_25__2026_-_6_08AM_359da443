    #canvas-container { position: fixed; inset: 0; z-index: 1; cursor: grab; }
    #canvas-container:active { cursor: grabbing; }
    .mono { font-family: 'JetBrains Mono', monospace; }
    
    /* Glassmorphism panels */
    .glass {
      background: rgba(15, 23, 42, 0.78);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      border: 1px solid rgba(148, 163, 184, 0.16);
      box-shadow: 0 10px 30px -5px rgba(0, 0, 0, 0.5);
    }
    .glass-card {
      background: rgba(30, 41, 59, 0.6);
      border: 1px solid rgba(148, 163, 184, 0.14);
    }

    /* Floating 3D Labels & Speech Bubbles */
    #labels-layer { position: fixed; inset: 0; pointer-events: none; z-index: 5; overflow: hidden; }
    .emp-tag {
      position: absolute;
      transform: translate(-50%, -100%);
      transition: opacity 0.2s;
      pointer-events: auto;
      cursor: pointer;
    }
    .speech-bubble {
      animation: floatBubble 2.6s ease-in-out infinite;
    }
    @keyframes floatBubble {
      0%, 100% { transform: translateY(0px); }
      50% { transform: translateY(-4px); }
    }

    /* Custom Scrollbar */
    ::-webkit-scrollbar { width: 5px; height: 5px; }
    ::-webkit-scrollbar-track { background: rgba(15, 23, 42, 0.4); }
    ::-webkit-scrollbar-thumb { background: rgba(99, 102, 241, 0.5); border-radius: 9999px; }
    ::-webkit-scrollbar-thumb:hover { background: rgba(99, 102, 241, 0.8); }

    /* Toast Notification */
    #toast-container { position: fixed; bottom: 84px; right: 16px; z-index: 60; display: flex; flex-direction: column; gap: 8px; pointer-events: none; }
  </style>
</head>
