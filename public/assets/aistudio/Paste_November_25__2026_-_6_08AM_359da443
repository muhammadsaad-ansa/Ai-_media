      if (!autoMode) return;
      const randomEmp = EMPLOYEES[Math.floor(Math.random() * EMPLOYEES.length)];
      const states = ['work', 'work', 'work', 'meeting', 'coffee', 'garden', 'sleep'];
      const nextAct = states[Math.floor(Math.random() * states.length)];
      randomEmp.activity = nextAct;
      randomEmp.customBubble = '';
      updateEmployeeTarget(randomEmp);
      if (selectedEmployeeId === randomEmp.id) {
        selectEmployee(randomEmp.id, false);
