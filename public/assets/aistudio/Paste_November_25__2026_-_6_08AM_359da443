    // Simulate full 7-AI pipeline producing & uploading 1 Reel to all connected platforms
    function triggerUploadCycle(manual = false) {
      const connected = SOCIAL_ACCOUNTS.filter(a => a.connected);
      if (connected.length === 0) {
        showToast('⚠️ Hubungkan minimal 1 akun sosial media terlebih dahulu!');
        openModal('social-modal');
        return;
      }

      // Pipeline steps reflected in 3D speech bubbles
      const hamza = EMPLOYEES.find(e => e.id === 'hamza');
      const abd = EMPLOYEES.find(e => e.id === 'abdaziz');
      const ilyas = EMPLOYEES.find(e => e.id === 'ilyas');
      const ilham = EMPLOYEES.find(e => e.id === 'ilham');
      const abbas = EMPLOYEES.find(e => e.id === 'abbas');
      const zubair = EMPLOYEES.find(e => e.id === 'zubair');

      hamza.tasksCompleted++;
      abd.tasksCompleted++;
      ilyas.tasksCompleted++;
      ilham.tasksCompleted++;
      animCounter++;
      dmCounter += Math.floor(Math.random() * 5) + 2;
      zubair.tasksCompleted = dmCounter;

      let uploadedCount = 0;
      connected.forEach(acc => {
        if (acc.uploadedToday < acc.dailyTarget) {
          acc.uploadedToday++;
          abbas.tasksCompleted++;
          uploadedCount++;
        }
      });

      // Temporary visual celebration bubbles in 3D
      flashEmployeeBubble('abdaziz', '✍️ Skrip konten siap!');
      setTimeout(() => flashEmployeeBubble('ilyas', '✨ Animasi 30 detik selesai!'), 600);
      setTimeout(() => flashEmployeeBubble('ilham', '🎬 Final render HD beres!'), 1200);
      setTimeout(() => flashEmployeeBubble('abbas', '🚀 Reel berhasil diupload!'), 1800);

      if (uploadedCount > 0) {
        addLog('Abbas', `Upload Reel baru ke ${connected.map(c => c.name).join(', ')}!`);
        if (manual) showToast(`🚀 Siklus AI Selesai! Reel baru diupload ke ${connected.length} akun.`);
      } else {
        addLog('Saad', `Target harian 5/5 Reel di semua akun terhubung sudah tercapai!`);
        if (manual) showToast(`🎉 Mantap! Target 5/5 Reel hari ini di semua akun sudah penuh!`);
      }

      updateHudBadges();
      renderDashboard();
    }

    function flashEmployeeBubble(empId, tempText) {
      const emp = EMPLOYEES.find(e => e.id === empId);
      if (!emp) return;
      const bubbleEl = document.getElementById(`bubble-${empId}`);
      if (bubbleEl) {
        bubbleEl.textContent = tempText;
        setTimeout(() => {
          bubbleEl.textContent = emp.statusText;
        }, 4000);
      }
    }

